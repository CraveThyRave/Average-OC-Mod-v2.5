  inGameOver = false
	makeAnimatedLuaSprite('peepee', 'Freeplay-Chrs/fah/overlay/autistic-person1', 0, 200)
	addAnimationByPrefix('peepee', 'idle', 'idle', 3, true)
	addLuaSprite('peepee', false)
