    "text": "La, la, la, la..."
  },
  {
    "start": 10.58,
    "end": 13.576,
    "text": "La, la, la..."
  },
  {
    "start": 13.64,
    "end": 16.61,
    "text": "La, la, la..."
  },
  {
    "start": 16.68,
    "end": 17.69,
    "text": "La...",
    "hudReveal": true
  },
  {
    "start": 17.84,
    "end": 20.54,
    "text": "A song in the night,"
  },
  {
    "start": 20.87,
    "end": 23.82,
    "text": "Be scared and in fright."
  },
  {
    "start": 23.82,
    "end": 26.32,
    "text": "As thunder booms loud,"
  },
  {
    "start": 26.32,
    "end": 29.42,
    "text": "You're scared of the light."
  },
  {
    "start": 29.42,
    "end": 30.26,
    "text": "AND I..."
  },
  {
    "start": 30.26,
    "end": 32.24,
    "text": "Will crush your bones!"
  },
  {
    "start": 32.24,
    "end": 35.1,
    "text": "A feast to behold!"
  },
  {
    "start": 35.78,
    "end": 38.46,
    "text": "It's so tart..."
  },
  {
    "start": 41.24,
    "end": 43.64,
    "text": "And let me take your heart."
  },
  {
    "start": 44.02,
    "end": 46.994,
    "text": "La-da, la-da, la..."
  },
  {
    "start": 47.04,
    "end": 49.462,
    "text": "La-da, la-da, la..."
  },
  {
    "start": 54.33,
    "end": 56.6,
    "text": "Your flesh"
  },
  {
    "start": 56.6,
    "end": 58.56,
    "text": "And brain"
  },
  {
    "start": 58.56,
    "end": 61.84,
    "text": "In an old"
  },
  {
    "start": 61.84,
    "end": 64.68,
    "text": "Green-blue shade..."
  },
  {
    "start": 64.68,
    "end": 68.44,
    "text": "Oh, it's you!"
  },
  {
    "start": 78.18,
    "end": 78.76,
    "text": "You can"
  },
  {
    "start": 78.76,
    "end": 81.16,
    "text": "Try to hide"
  },
  {
    "start": 81.16,
    "end": 84.32,
    "text": "From spooky scares,"
  },
  {
    "start": 84.46,
    "end": 86.7,
    "text": "But nightmares"
  },
  {
    "start": 86.5,
    "end": 89.62,
    "text": "Will haunt..."
  },
  {
    "start": 91.1,
    "end": 93.92,
    "text": "I'd love to make you"
  },
  {
    "start": 93.92,
    "end": 95.6,
    "text": "A tasty stew"
  },
  {
    "start": 95.6,
    "end": 98.94,
    "text": "To enjoy with your friends,"
  },
  {
    "start": 98.94,
    "end": 100.76,
    "text": "But it will have to wait"
  },
  {
    "start": 100.76,
    "end": 102.32,
    "text": "Until the next time"
  },
  {
    "start": 102.32,
    "end": 104.2,
    "text": "We meet again!"
  }
